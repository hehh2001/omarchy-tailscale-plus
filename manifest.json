{
  "schemaVersion": 1,
  "id": "hehh2001.tailscale-plus",
  "name": "Tailscale Plus",
  "version": "1.5.2",
  "author": "hehh2001",
  "license": "MIT",
  "description": "A full-featured, native Omarchy control panel for Tailscale.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Tailscale Plus",
    "description": "Control connections, exit nodes, DNS, routes, privacy, sharing, updates, and peers.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 30,
      "exitNodeDns": "",
      "manageExitNodeDns": false,
      "loginServer": "https://controlplane.tailscale.com",
      "exitNodeDnsMap": "{}"
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 3600,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "manageExitNodeDns",
        "type": "boolean",
        "label": "Switch DNS with exit node",
        "defaultValue": false
      },
      {
        "key": "exitNodeDns",
        "type": "string",
        "label": "Exit node DNS server",
        "defaultValue": ""
      },
      {
        "key": "loginServer",
        "type": "string",
        "label": "Login server URL",
        "defaultValue": "https://controlplane.tailscale.com"
      },
      {
        "key": "exitNodeDnsMap",
        "type": "string",
        "label": "Per-tailnet exit node DNS map (JSON)",
        "defaultValue": "{}"
      }
    ]
  }
}
