#!/usr/bin/env bash
set -euo pipefail

# Reviewed root helper for Tailscale Plus DNS switching.
#
# The sudoers rule allows ONLY this exact helper with NO arguments:
#   user ALL=(root) NOPASSWD: /usr/local/libexec/omarchy-tailscale-plus-dns ""
#
# The desktop plugin sends a one-line request on stdin:
#   on <canonical-ipv4-or-ipv6>
#   off
#
# Manual/legacy command-line form is also accepted when run outside sudo:
#   omarchy-tailscale-plus-dns on <dns-server> [tailscale0]
#   omarchy-tailscale-plus-dns off _ [tailscale0]

action=""
dns_server=""
interface="tailscale0"

if [[ $# -ge 1 ]]; then
  action="${1:-}"
  dns_server="${2:-}"
  [[ $# -ge 3 ]] && interface="${3:-tailscale0}"
else
  IFS= read -r -n 128 request || true
  case "$request" in
    on\ *)
      action="on"
      dns_server="${request#on }"
      ;;
    off)
      action="off"
      ;;
    *)
      echo "Invalid request. Expected 'on <dns>' or 'off' on stdin." >&2
      exit 64
      ;;
  esac
fi

if [[ $EUID -ne 0 ]]; then
  echo "This helper must run as root." >&2
  exit 77
fi

if [[ $interface != tailscale0 ]]; then
  echo "Only tailscale0 is supported." >&2
  exit 64
fi

valid_ipv4() {
  local addr=$1 octet
  local -a octets
  [[ ${#addr} -le 15 && $addr =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  IFS=. read -r -a octets <<<"$addr"
  [[ ${#octets[@]} -eq 4 ]] || return 1
  for octet in "${octets[@]}"; do
    [[ $octet =~ ^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$ ]] || return 1
  done
  return 0
}

valid_ipv6() {
  local addr=$1
  [[ ${#addr} -le 45 ]] || return 1
  [[ $addr =~ ^([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}$ ]] && return 0
  [[ $addr =~ ^::([0-9a-fA-F]{1,4}:){0,6}[0-9a-fA-F]{1,4}$ ]] && return 0
  [[ $addr =~ ^([0-9a-fA-F]{1,4}:){1,7}:$ ]] && return 0
  [[ $addr =~ ^([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}$ ]] && return 0
  [[ $addr =~ ^([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}$ ]] && return 0
  [[ $addr =~ ^([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}$ ]] && return 0
  [[ $addr =~ ^([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}$ ]] && return 0
  [[ $addr =~ ^([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}$ ]] && return 0
  [[ $addr =~ ^[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})$ ]] && return 0
  [[ $addr =~ ^:((:[0-9a-fA-F]{1,4}){1,7}|:)$ ]] && return 0
  return 1
}

case "$action" in
on)
  [[ -n $dns_server ]] || { echo "A DNS server is required." >&2; exit 64; }
  if ! valid_ipv4 "$dns_server" && ! valid_ipv6 "$dns_server"; then
    echo "DNS server must be a canonical IPv4 or IPv6 address." >&2
    exit 64
  fi
  /usr/bin/resolvectl dns "$interface" "$dns_server"
  /usr/bin/resolvectl domain "$interface" '~.'
  /usr/bin/resolvectl default-route "$interface" yes
  /usr/bin/resolvectl flush-caches
  ;;
off)
  /usr/bin/resolvectl revert "$interface"
  /usr/bin/resolvectl flush-caches
  ;;
*)
  echo "Usage: $0 on <dns-server> | off" >&2
  exit 64
  ;;
esac
