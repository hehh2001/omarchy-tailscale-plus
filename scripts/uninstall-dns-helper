#!/usr/bin/env bash
set -euo pipefail

if [[ -x /usr/local/libexec/omarchy-tailscale-plus-dns ]]; then
  printf 'off\n' | /usr/bin/sudo /usr/local/libexec/omarchy-tailscale-plus-dns || true
fi
/usr/bin/sudo /usr/bin/rm -f /etc/sudoers.d/omarchy-tailscale-plus-dns
/usr/bin/sudo /usr/bin/rm -f /usr/local/libexec/omarchy-tailscale-plus-dns
echo "Removed the Tailscale Plus DNS helper and sudo rule."
