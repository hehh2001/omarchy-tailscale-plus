#!/usr/bin/env bash
set -euo pipefail

plugin_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
helper=/usr/local/libexec/omarchy-tailscale-plus-dns
sudoers=/etc/sudoers.d/omarchy-tailscale-plus-dns
target_user="${SUDO_USER:-${USER:-}}"

[[ -n $target_user && $target_user != root ]] || {
  echo "Run this as your desktop user, not from a root shell." >&2
  exit 64
}

sudo install -d -m 0755 /usr/local/libexec
sudo install -o root -g root -m 0755 "$plugin_dir/scripts/omarchy-tailscale-plus-dns" "$helper"

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
printf '%s ALL=(root) NOPASSWD: %s on *, %s off *\n' "$target_user" "$helper" "$helper" >"$tmp"
sudo visudo -cf "$tmp"
sudo install -o root -g root -m 0440 "$tmp" "$sudoers"

echo "Installed $helper and a command-scoped sudo rule for $target_user."
